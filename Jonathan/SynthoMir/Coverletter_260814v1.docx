    "             \"Hsa-Mir-430-P47_5p\", \"Hsa-Mir-642_5p\", \"Hsa-Mir-23-P2_3p\", \"Hsa-Mir-541_3p\", \"Hsa-Mir-542-v1_3p\", \n",
