#!/usr/local/bin/snakemake

import sys; sys.path.append('/home/kwonschul/notebooks')
import time

# 
# IMPORTANT: consider direction when analyzing shRNAmir
# The user needs to make a 'logs' folder manually before running the code
#

RAW_DATA_DIR = '..'
BOWTIE2INDEX = '/home/kwonschul/data/genome/shrna/bowtie2_miseq4/'

SAMPLES = ['1mir33',
          '2mirGE',
          '3pGIPZ',
          '4J3',
          '6mir26',
          '7mir26ghg',
          '8mir16',
          '9mir16ghg']


ADAPTER_3P = 'TGGAATTCTCGGGTGCCAAGG' #TruSeq Small RNA
#MAX_DIFF = 5
MIN_QUAL = 20
#MIN_QUALIFIED = 90
RANDOM_SEQ_5p = 4 # Four random nucleotides 
RANDOM_SEQ_3p = -4 # Four random nucleotides
MIN_INSERT_LEN = 18
MAX_INSERT_LEN = 26


# write a log for each run

DATE = time.strftime('%y%m%d')
LOG = 'logs/%s.log' % DATE
logf = open(LOG, 'a')
STAMP = '========== NEW RUN at %s ==========\n' % time.time()
logf.write(STAMP)
logf.close()



rule all:
    input: 'logs/%s.log' % DATE,
           expand('data/{sample}.trima.fasta.gz', sample=SAMPLES),
           expand('data/{sample}.insertonly.fasta.gz', sample=SAMPLES),
           expand('data/{sample}.shrna.bt2output.sam', sample=SAMPLES),
           expand('data/{sample}.shrna.bt2output.unsorted.bam', sample=SAMPLES),
           expand('data/{sample}.shrna.bt2output.sorted.bam', sample=SAMPLES),
           expand('data/{sample}.shrna.bt2output.sorted.bam.bai', sample=SAMPLES),
           expand('annotated/{sample}.shrna.bed', sample=SAMPLES),
           expand('annotated/{sample}.shrna.count.txt', sample=SAMPLES),
           expand('annotated/{sample}.shrna.position.txt', sample=SAMPLES)

rule make_log:
    output: 'logs/%s.log' % DATE
    shell: 'echo "{STAMP}" > {output}'

rule trim_adapter:							# I put --fasta output option here!
    output: 'data/{sample}.trima.fasta.gz'
    shell: 'zcat {RAW_DATA_DIR}/{wildcards.sample}.fq.gz | \
            cutadapt - -a {ADAPTER_3P} --fasta --trimmed-only --quality-cutoff {MIN_QUAL} -m {MIN_INSERT_LEN} 2>> {LOG} | \
            gzip -c - > {output}'

rule remove_random_sequences:
    input: 'data/{sample}.trima.fasta.gz'
    output: 'data/{sample}.insertonly.fasta.gz'
    shell: 'zcat {input} | \
            cutadapt - -u {RANDOM_SEQ_5p} -u {RANDOM_SEQ_3p} -m {MIN_INSERT_LEN} -M {MAX_INSERT_LEN} \
			2>> {LOG} | \
            gzip -c - > {output}'

# shRNA mapping --------------------------------------------------------------------------------

rule bowtie2_mapping_shrna:
    input: 'data/{sample}.insertonly.fasta.gz'  #bowtie2 can get gziped files as input
    output: 'data/{sample}.shrna.bt2output.sam'
    params: idx = BOWTIE2INDEX + '{sample}_ref'
    shell: 'bowtie2 -f -p 4 --score-min C,0,-1 -k 2 \
            -U {input} -x {params.idx} -S {output} \
			2>> {LOG}'
# no mismatches allows; report 2 mappings

rule remove_multiple_mapped_reads:
    input: 'data/{sample}.shrna.bt2output.sam'
    output: 'data/{sample}.shrna.bt2output.uniq.sam'
	shell: 'python3 remove_multiple_mapped_reads.py {input} {output}'

rule sam_to_bam:
    input: 'data/{sample}.shrna.bt2output.uniq.sam'
    output: 'data/{sample}.shrna.bt2output.unsorted.bam'
    threads: 8
    shell: 'samtools view -bS -F 4 -@ {threads} {input} > {output}'
# -F 4 will remove all unmapped reads (https://www.ncbi.nlm.nih.gov/geo/query/acc.cgi?acc=GSM1938988)

rule sort_bam:
    input: 'data/{sample}.shrna.bt2output.unsorted.bam'
    output: 'data/{sample}.shrna.bt2output.sorted.bam'
    threads: 8
    shell: 'samtools sort -o {output} -O bam -@ {threads} {input}'

rule index_bam: 
    input: 'data/{sample}.shrna.bt2output.sorted.bam'
    output: 'data/{sample}.shrna.bt2output.sorted.bam.bai'
    shell: 'samtools index -b {input}'

rule bedtools_bam_to_bed:    
    input: 'data/{sample}.shrna.bt2output.sorted.bam'
    output: 'annotated/{sample}.shrna.bed'
    shell: 'bedtools bamtobed -i {input} > {output}'

# IMPORTANT: only + strand-mapped reads should be counted
rule get_shrek_count:
    input: 'annotated/{sample}.shrna.bed'
    output: 'annotated/{sample}.shrna.count.txt'
    shell: """
	   	   awk -F "\\t" '$6=="+"' {input} | \
           awk -F "\\t" '{{print $1}}' | \
           sort | \
           uniq -c | \
           sort -nr > {output}
           """

# IMPORTANT: only + strand-mapped reads should be counted
rule get_shrek_position:
    input: 'annotated/{sample}.shrna.bed'
    output: 'annotated/{sample}.shrna.position.txt'
    shell: """
	       awk -F "\\t" '$6=="+"' {input}| \
           awk -F "\\t" '{{OFS="\\t"; print $1, $2, $3, $4}}' > {output}
           """

